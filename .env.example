# Bank Intelligence Platform — необязательные настройки.
# Файл можно не создавать: все значения имеют разумные значения по умолчанию.

# Путь к файлу базы SQLite
# DB_PATH=data/bank.db

# Порт приложения
# APP_PORT=8000

# Бизнес-пороги ATM
# LOW_CASH_PCT=0.20
# WARNING_CASH_PCT=0.40
# DEFAULT_CAPACITY=400000000

# ── atm_monitor (встроен в проект, запускается вместе с сервером) ──────────
# Сборщик раз в час опрашивает monitoring.btech.uz и пишет данные в SQLite
# data/atm_monitor.db. Без AUTH_USERNAME/AUTH_PASSWORD он не стартует, а
# остальная платформа работает как обычно (без «живого» баланса).
# AUTH_USERNAME=
# AUTH_PASSWORD=
# API_BASE_URL=https://monitoring.btech.uz
# ATM_LIST_PATH=/api/base/atm/
# LOGIN_PATH=/api/login
# LOGIN_USERNAME_FIELD=email
# LOGIN_PASSWORD_FIELD=password
# LOGIN_TOKEN_RESPONSE_FIELD=token
# POLL_INTERVAL_HOURS=1
# ATM_COLLECTOR=1              # 0 — не запускать сборщик вместе с сервером
# ATM_MONITOR_DB_PATH=data/atm_monitor.db
