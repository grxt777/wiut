# Cash Flow AI — необязательные настройки.
# Файл можно не создавать: все значения имеют разумные значения по умолчанию.

# Путь к файлу базы SQLite
# DB_PATH=data/bank.db

# Порт приложения
# APP_PORT=8000

# Бизнес-пороги ATM
# LOW_CASH_PCT=0.20
# WARNING_CASH_PCT=0.40
# DEFAULT_CAPACITY=400000000

# Телеметрия банкоматов (SQLite)
# ATM_MONITOR_DB_PATH=data/atm_monitor.db

# Синтетическое наполнение пустой базы (0 — выключить)
# SEED_SYNTHETIC=1
